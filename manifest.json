{
  "manifest_version": 3,
  "name": "CZalculator",
  "version": "0.1.0",
  "description": "Označte výřez stránky: částky v cizích měnách převede na Kč podle kurzu ČNB a sečte je.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage", "alarms", "contextMenus"],
  "host_permissions": ["https://www.cnb.cz/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Sečíst a převést na Kč (Alt+Shift+S)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "activate": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Označit výřez a spočítat částky"
    }
  }
}
